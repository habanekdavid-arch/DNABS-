# Kontaktný formulár posiela e-maily cez Gmail SMTP (nodemailer).
# Skopíruj tento súbor ako .env.local a doplň reálne hodnoty — NEHARDCODUJ ich do kódu.

# Gmail adresa, z ktorej sa posielajú dopyty (musí mať zapnuté 2-faktorové overenie).
GMAIL_USER=

# App password vygenerované v Google Account -> Security -> App passwords
# (nie je to bežné heslo k účtu).
GMAIL_APP_PASSWORD=

# Google Analytics 4 Measurement ID vo formáte G-XXXXXXXXXX.
# Nájdeš ho v GA4 -> Admin -> Data streams -> tvoj web stream.
# Keď je prázdne, GA4 sa vôbec nenačíta a web beží bez zmeny
# (Google Ads tag AW-18360461587 je v kóde napevno a beží nezávisle).
# Musí byť nastavené aj vo Vercel -> Settings -> Environment Variables.
NEXT_PUBLIC_GA4_ID=
